{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nicolesbach",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true
  },
  "main": "@tanstack/react-start/server-entry",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "BACH_KV",
      // Run `wrangler kv namespace create BACH_KV` to get these IDs,
      // then replace the placeholders below.
      "id": "REPLACE_WITH_KV_NAMESPACE_ID",
      "preview_id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
